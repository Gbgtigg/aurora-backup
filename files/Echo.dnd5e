					<element type="Proficiency" name="Gaming Set" requiredLevel="1" checksum="17fd0787" registered="ID_PROFICIENCY_GAMING_SET_PROFICIENCY_THREE_DRAGON_ANTE_SET" />
					<element type="Background Feature" name="Variant Feature" requiredLevel="1" checksum="2990563f" registered="" />
					<element type="List" name="Specialty" requiredLevel="1" checksum="90921c9a" isList="true" registered="5">Healer</element>
					<element type="List" name="Personality Trait" requiredLevel="1" number="1" checksum="6445c63b" isList="true" registered="2">I’m haunted by memories of war. I can’t get the images of violence out of my mind.</element>
					<element type="List" name="Personality Trait" requiredLevel="1" number="2" checksum="fd4c9781" isList="true" registered="3">I’ve lost too many friends, and I’m slow to make new ones.</element>
					<element type="List" name="Ideal" requiredLevel="1" checksum="3f04b355" isList="true" registered="3">Independence. When people follow orders blindly, they embrace a kind of tyranny. (Chaotic)</element>
					<element type="List" name="Bond" requiredLevel="1" checksum="72501116" isList="true" registered="4">I’ll never forget the crushing defeat my company suffered or the enemies who dealt it.</element>
					<element type="List" name="Flaw" requiredLevel="1" checksum="cd201956" isList="true" registered="3">I made a terrible mistake in battle cost many lives— and I would do anything to keep that mistake secret.</element>
					<element type="Proficiency" name="Athletics" id="ID_PROFICIENCY_SKILL_ATHLETICS" />
					<element type="Proficiency" name="Intimidation" id="ID_PROFICIENCY_SKILL_INTIMIDATION" />
