					<element type="Proficiency" name="Artisan Tools (Inquisitor)" requiredLevel="1" checksum="6b880158" registered="ID_DMSG_HMGS_PROFICIENCY_TOOL_EMBALMERS_TOOLS" />
					<element type="List" name="Personality Trait" requiredLevel="1" number="1" checksum="9fc240ee" isList="true" registered="1">It will all go smoothly if everyone just does as I say.</element>
					<element type="List" name="Personality Trait" requiredLevel="1" number="2" checksum="06cb1154" isList="true" registered="7">I want to see the wicked burn for the evil they’ve brought on us.</element>
					<element type="List" name="Ideal" requiredLevel="1" checksum="7d7f8f96" isList="true" registered="4">Humanity. Human life is to be cherished and preserved against the horrors of the night. (Good)</element>
					<element type="List" name="Bond" requiredLevel="1" checksum="bbf4be3f" isList="true" registered="2">One day, I will claim vengeance against the monster that took my family from me.</element>
					<element type="List" name="Flaw" requiredLevel="1" checksum="0484b67f" isList="true" registered="6">I’ll do whatever grim task must be done, for my soul is already lost.</element>
					<element type="Proficiency" name="Investigation" id="ID_PROFICIENCY_SKILL_INVESTIGATION" />
					<element type="Proficiency" name="Religion" id="ID_PROFICIENCY_SKILL_RELIGION" />
					<element type="Proficiency" name="Tool Proficiency (Thieves’ tools)" id="ID_PROFICIENCY_TOOL_PROFICIENCY_THIEVES_TOOLS" />
					<element type="Background Feature" name="Feature: Legal Authority" id="ID_WOTC_PSI_BACKGROUND_FEATURE_LEGAL_AUTHORITY" />
				</element>
				<element type="Alignment" name="Alignment" requiredLevel="1" checksum="c9ac49d5" registered="" />
